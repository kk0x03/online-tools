# LLM API Configuration (OpenAI-compatible)
API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
API_KEY=your-api-key-here
MODEL_NAME=glm-5

# Server
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Auth
AUTH_DB_PATH=./data/auth.sqlite
SESSION_SECRET=change-this-long-random-secret
SESSION_COOKIE_NAME=mo_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Email login codes
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_REQUEST_WINDOW_MINUTES=10
LOGIN_CODE_REQUEST_LIMIT=5

# SMTP email delivery (when omitted, login codes are logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Mermaid Online <no-reply@example.com>"

# AI usage limits
AI_USAGE_LIMITS_ENABLED=true
AI_ANON_COOKIE_NAME=mo_anon_id
AI_ANON_COOKIE_TTL_DAYS=365
AI_CHAT_MAX_MESSAGES=20
AI_CHAT_MAX_CONTENT_CHARS=12000
AI_CHAT_MAX_PAYLOAD_BYTES=65536
AI_COMPLETE_MAX_CODE_CHARS=12000

# AI usage quota defaults
AI_CHAT_ANON_DAILY_LIMIT=10
AI_CHAT_ANON_BURST_LIMIT=5
AI_CHAT_USER_DAILY_LIMIT=30
AI_CHAT_USER_BURST_LIMIT=10
AI_CHAT_IP_DAILY_LIMIT=20
AI_CHAT_IP_BURST_LIMIT=5
AI_COMPLETE_ANON_DAILY_LIMIT=100
AI_COMPLETE_ANON_BURST_LIMIT=20
AI_COMPLETE_USER_DAILY_LIMIT=300
AI_COMPLETE_USER_BURST_LIMIT=40
AI_COMPLETE_IP_DAILY_LIMIT=200
AI_COMPLETE_IP_BURST_LIMIT=20
